# ---------------------------------------------------------------------------
# Copy this file to `.env.local` and fill in the values you need.
# `.env.local` is git-ignored; this example is safe to commit.
# ---------------------------------------------------------------------------

# Absolute site origin, used for canonical URLs and Open Graph / social cards.
# Optional — falls back to the default in components/v2/lib/constants.js.
NEXT_PUBLIC_SITE_URL=https://www.karthikvanam.vercel.app

# Analytics (optional). Tracking is disabled on localhost regardless.
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_CLARITY_ID=
